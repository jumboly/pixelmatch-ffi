<Project>
  <!-- 中核とアダプターのパッケージを常に同じバージョンで出すため、ここで一元管理する -->
  <PropertyGroup>
    <Version>0.1.0</Version>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PackageLicenseExpression>ISC</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/jumboly/pixelmatch-ffi</RepositoryUrl>
    <PackageProjectUrl>https://github.com/jumboly/pixelmatch-ffi</PackageProjectUrl>
  </PropertyGroup>

  <!-- ISC 等は「複製物に著作権表示を含めること」が条件のため、全パッケージにライセンス文を同梱する -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../LICENSE" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../../THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>
